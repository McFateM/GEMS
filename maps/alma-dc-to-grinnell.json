{
  "name": "Alma Dublin Core to Grinnell CollectionBuilder template",
  "decisions": "maps/alma-dc-to-grinnell.md",
  "columns": [
    "objectid", "parentid", "display_template", "original_file_name", "originating_system_id",
    "object_location", "image_small", "image_thumb", "image_alt_text", "thumb_focus",
    "title", "title_alternative", "creator_personal", "creator_org", "interviewee", "interviewer", "date", "time_period",
    "description", "subject_topic", "subject_person", "subject_organization", "keywords",
    "contributor_personal", "contributor_org", "location", "latitude", "longitude", "lanugage",
    "source", "provenance", "shelf_locator", "call_number", "archival_series", "box", "folder_title", "folder_number",
    "finding_aid_permalink", "contributing_institution", "publisher", "extent", "medium", "genre",
    "type", "format", "digital_collection_title", "digital_collection_permalink", "related",
    "avian_identifier", "identifier", "filename", "item_permalink", "rights", "standardized_rights",
    "disclaimer"
  ],
  "rules": {
    "objectid": {"from": "gems.objectid", "child": "inherit"},
    "parentid": {"from": "gems.parentid", "child": "inherit"},
    "display_template": {"from": "gems.display_template", "child": "inherit"},
    "original_file_name": {"from": "gems.filename", "child": "inherit"},
    "originating_system_id": {"from": "record.mms_id", "child": {"from": "gems.representation_id"}},
    "title": {"from": ["metadata.dc:title", "metadata.dcterms:title"], "split": false, "child": {"from": ["gems.label", "gems.filename"], "split": false}},
    "title_alternative": {"from": "metadata.dcterms:alternative"},
    "creator_personal": {"from": ["metadata.dc:creator", "metadata.dcterms:creator"], "combine": true, "match": "^[A-Z][\\w'’.-]*(?: [A-Z][\\w'’.-]*)?, [A-Z]", "fallback": {"from": "mods.creator_personal"}},
    "creator_org": {"from": ["metadata.dc:creator", "metadata.dcterms:creator"], "combine": true, "exclude": "^[A-Z][\\w'’.-]*(?: [A-Z][\\w'’.-]*)?, [A-Z]", "fallback": {"from": "mods.creator_corporate"}},
    "date": {"from": ["metadata.dcterms:created", "metadata.dc:date", "metadata.dcterms:date"]},
    "time_period": {"from": "metadata.dcterms:temporal"},
    "description": {"from": ["metadata.dcterms:abstract", "metadata.dc:description", "metadata.dcterms:description"], "split": false},
    "keywords": {"from": "metadata.dc:subject"},
    "subject_topic": {"from": ["metadata.dcterms:subject (dcterms:LCSH)", "metadata.dcterms:subject"], "combine": true, "exclude": "^[A-Z][\\w'’.-]*(?: [A-Z][\\w'’.-]*)?, [A-Z]"},
    "subject_person": {"from": ["metadata.dcterms:subject (dcterms:LCSH)", "metadata.dcterms:subject"], "combine": true, "match": "^[A-Z][\\w'’.-]*(?: [A-Z][\\w'’.-]*)?, [A-Z]"},
    "contributor_personal": {"from": ["metadata.dc:contributor", "metadata.dcterms:contributor"], "combine": true, "match": "^[A-Z][\\w'’.-]*(?: [A-Z][\\w'’.-]*)?, [A-Z]", "fallback": {"from": "mods.contributor_personal"}},
    "contributor_org": {"from": ["metadata.dc:contributor", "metadata.dcterms:contributor"], "combine": true, "exclude": "^[A-Z][\\w'’.-]*(?: [A-Z][\\w'’.-]*)?, [A-Z]", "fallback": {"from": "mods.contributor_corporate"}},
    "location": {"from": "metadata.dcterms:spatial"},
    "lanugage": {"from": ["metadata.dc:language", "metadata.dcterms:language"], "combine": true},
    "provenance": {"from": "metadata.dcterms:provenance"},
    "shelf_locator": {"from": ["record.shelf_locator", "metadata.shelf_locator"], "split": false, "fallback": {"from": "mods.shelf_locator", "split": false}, "child": "inherit"},
    "contributing_institution": {"value": "Grinnell College Libraries", "child": "inherit"},
    "publisher": {"from": ["metadata.dcterms:publisher", "metadata.dc:publisher"], "combine": true},
    "extent": {"from": "metadata.dcterms:extent", "fallback": {"from": "mods.extent"}},
    "medium": {"from": "metadata.dcterms:medium", "fallback": {"from": "mods.form"}},
    "genre": {"fallback": {"from": "mods.genre"}},
    "type": {"from": ["metadata.dcterms:type (dcterms:DCMIType)", "metadata.dc:type", "gems.dcmi_type"], "child": {"from": "gems.dcmi_type"}},
    "format": {"from": ["gems.mime_type", "metadata.dc:format"], "combine": true, "child": "inherit"},
    "digital_collection_title": {"from": "metadata.dcterms:isPartOf", "exclude": "^Digital Grinnell$"},
    "related": {"from": ["metadata.dcterms:relation", "metadata.dc:relation"], "combine": true},
    "identifier": {
      "from": "metadata.dc:identifier",
      "match": "^grinnell:\\d+$",
      "child": {"from": "gems.original_name", "extract": "(grinnell_\\d+)", "replace": ["^grinnell_", "grinnell:"]}
    },
    "filename": {"from": "gems.filenames", "child": "inherit"},
    "item_permalink": {"from": ["metadata.dcterms:identifier (dcterms:URI)", "metadata.dc:identifier"], "match": "^https?://hdl\\.handle\\.net/"},
    "rights": {"from": ["metadata.dc:rights", "metadata.dcterms:rights"], "split": false, "strip_html": true, "child": "inherit"},
    "standardized_rights": {
      "from": ["metadata.dc:rights", "metadata.dcterms:rights"],
      "split": false,
      "extract": "href=\"(https?://rightsstatements\\.org/[^\"]+)\"",
      "replace": ["^https?://rightsstatements\\.org/page/([^/]+/[^/?]+)/?.*$", "http://rightsstatements.org/vocab/\\1/"],
      "child": "inherit"
    }
  }
}
